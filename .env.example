# spyxbd Environment Configuration Template

# Database configuration (PostgreSQL or leave unset to use local embedded storage)
DATABASE_URL="postgresql://postgres:password@localhost:5432/spyxbd?schema=public"

# Telegram Bot API Configuration (Admin: @talhajubayer001)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_from_botfather"
TELEGRAM_CHAT_ID="8220144989"
TELEGRAM_ADMIN_USERNAME="talhajubayer001"
TELEGRAM_ADMIN_USER_IDS="8220144989"
TELEGRAM_WEBHOOK_SECRET="replace_with_a_random_secret"
ADMIN_API_SECRET="replace_with_a_different_random_secret"

# Application Settings
APP_BASE_URL="https://your-public-domain.example"
NODE_ENV="production"
PORT=3000

# Retention Period (Days to retain precise GPS telemetry data before automatic purge)
DATA_RETENTION_DAYS=30
